{
  "manifest_version": 3,
  "name": "Ramayana Movie Countdown (Fan Made)",
  "short_name": "Ramayana",
  "version": "1.0.0",
  "description": "Unofficial fan extension: live countdown to the Ramayana Part 1 release, a quick cast guide and links to the latest news.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ramayana Movie Countdown",
